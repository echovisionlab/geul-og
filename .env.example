# Geul OG Image Generation Service

# Server
PORT=3010
LOG_LEVEL=info

# PGMQ (least-privilege role membership for the OG queue)
DATABASE_DSN=postgres://geul_og:change-me@localhost:5432/geul?sslmode=disable
OG_SHUTDOWN_TIMEOUT_MS=120000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_MEDIA_BUCKET=geul
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Backend Internal API
BACKEND_URL=http://localhost:8000
TOKEN_SIGNING_SECRET=replace-with-the-shared-backend-token-signing-secret

# Optional logging and telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=service.namespace=geul,deployment.environment=development
OTEL_DEBUG=false
